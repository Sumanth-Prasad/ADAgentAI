          "character": 89
        }
      },
      "title": "4. IDs checked first",
      "description": "Every ad source and ad unit id is checked against your account. A wrong id goes back to the model to fix, before you see anything."
    },
    {
      "file": "backend/chat/graph/nodes/tool_executor.py",
      "line": 472,
