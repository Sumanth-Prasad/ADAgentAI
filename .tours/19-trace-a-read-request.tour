        }
      },
      "title": "7. Entity loader: your real accounts",
      "description": "Your AdMob publisher id, apps and ad units are loaded and written into the prompt, so the model uses real ids (tour 08)."
    },
    {
      "file": "backend/mcp_servers/annotations.py",
      "line": 373,
